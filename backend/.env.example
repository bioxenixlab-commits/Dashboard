# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app,.vercel.app

# Database (Neon PostgreSQL) - get from https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.c-5.us-east-2.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Settings
JWT_ACCESS_LIFETIME=60m
JWT_REFRESH_LIFETIME=7d